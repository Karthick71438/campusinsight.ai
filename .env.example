# LearnGraph AI Environment Configuration

# Application Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL / Supabase Connection (Optional - defaults to SQLite local database if unset)
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite:///./learngraph.db

# Neo4j AuraDB Connection (Optional - defaults to embedded NetworkX graph engine if unset)
# NEO4J_URI=neo4j+s://[INSTANCE_ID].databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=[YOUR_NEO4J_PASSWORD]

# Optional AI / LLM API Key (for extended concept extraction & rich pedagogical explanations)
# GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Stability & Decay Thresholds
THRESHOLD_STRONG=85.0
THRESHOLD_STABLE=70.0
THRESHOLD_WEAKENING=50.0
DEFAULT_STABILITY_HALF_LIFE_DAYS=25.0
